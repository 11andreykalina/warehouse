  <diagram id="registration-access" name="Регистрация и доступ">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading-2" value="Регистрация, проверка сотрудника и авторизация" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17345D;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-start" value="Пользователь открывает приложение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a-choice" value="Есть учётная запись?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="390" y="120" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a-login" value="Войти&#xa;Корпоративная учётная запись / SSO&#xa;MFA при необходимости" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="90" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a-invite" value="Нет открытой саморегистрации&#xa;Запросить приглашение у администратора&#xa;или начать регистрацию по приглашению" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="260" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="a-verify" value="Проверка регистрации&#xa;Одноразовый токен-приглашение&#xa;Рабочая почта / табельный номер&#xa;Администратор подтверждает профиль и подразделение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1060" y="245" width="280" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a-auth" value="Провайдер идентификации&#xa;OIDC / OAuth 2.1&#xa;Проверка пароля / SSO / MFA&#xa;Учёт блокировки и выхода" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1060" y="80" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a-token" value="Создать защищённую сессию&#xa;Короткоживущий токен + refresh rotation&#xa;HttpOnly Secure SameSite cookie предпочтительнее хранения токена в localStorage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1060" y="430" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="a-profile" value="Профиль сотрудника&#xa;ФИО • подразделение • должность/категория&#xa;Пол и служебные условия для подбора норм&#xa;Минимизация персональных данных" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="450" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a-rbac" value="Назначение роли (RBAC)&#xa;Сотрудник: каталог, свои заявки/гардероб&#xa;Кладовщик: остатки и подтверждение выдачи&#xa;Администратор: пользователи, справочники, нормы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="640" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a-ready" value="Доступ к приложению&#xa;Все запросы авторизуются на сервере&#xa;Права проверяются на каждом действии&#xa;Критичные изменения попадают в audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1060" y="650" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="a-note" value="Важно: демо-экран входа в текущем прототипе не является безопасной регистрацией и не создаёт серверную учётную запись. Для готовой системы регистрацию следует ограничить приглашениями/проверкой принадлежности к организации; восстановление пароля и отзыв доступа должны выполняться через провайдера идентификации." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;size=15;" vertex="1" parent="1">
          <mxGeometry x="70" y="490" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e-a1" value="" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="a-start" target="a-choice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a2" value="Да" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="a-choice" target="a-login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a3" value="Нет" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="a-choice" target="a-invite">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a4" value="приглашение" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="a-invite" target="a-verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a5" value="учётная запись" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="a-verify" target="a-auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a6" value="проверка credentials / MFA" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="a-login" target="a-auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a7" value="успешная аутентификация" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="a-auth" target="a-token">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a8" value="создать/обновить" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="a-verify" target="a-profile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a9" value="назначить по подразделению" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="a-profile" target="a-rbac">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a10" value="сессия + роль" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="a-token" target="a-ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a11" value="профиль и разрешения" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="a-rbac" target="a-ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="issue-lifecycle" name="Заявка и жизненный цикл">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading-3" value="Заявка, выдача со склада и срок носки" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17345D;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-catalog" value="Сотрудник выбирает товар&#xa;Каталог показывает общий ассортимент&#xa;и подборку по профилю / применимой норме" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="170" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-entitlement" value="Сервер проверяет право на выдачу&#xa;Профиль + версия нормы + условия&#xa;Срок и количество берутся из утверждённых данных&#xa;Нельзя подменить срок со стороны браузера" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="370" y="150" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b-request" value="Создать заявку&#xa;Размер • количество • подразделение&#xa;Статус: черновик → отправлена" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="170" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-review" value="Обработка заявки&#xa;Согласование руководителем — если требуется&#xa;Проверка остатка и резервирование&#xa;Отклонение с причиной либо готово к выдаче" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="150" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b-stock" value="Остатки склада&#xa;Транзакционное списание / резерв&#xa;История движения по каждой операции" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1070" y="360" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-issued" value="Кладовщик сверяет сотрудника и товар&#xa;Фиксирует фактическую дату и количество&#xa;Заявка: выдана&#xa;Создаётся запись выдачи с аудиторским следом" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="740" y="340" width="270" height="125" as="geometry" />
        </mxCell>
        <mxCell id="b-wardrobe" value="Гардероб сотрудника&#xa;Позиция • размер • дата получения&#xa;Применённая норма и её версия&#xa;wear_until = issued_at + нормативный срок" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="390" y="350" width="290" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b-timer" value="Обратный отсчёт&#xa;Остаток дней вычисляет сервер/API&#xa;Часовой пояс и календарная дата определены&#xa;Напоминание перед окончанием срока" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="390" y="550" width="290" height="105" as="geometry" />
        </mxCell>
        <mxCell id="b-expire-choice" value="Срок истёк?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="760" y="550" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b-archive" value="Автоматически архивировать&#xa;Причина: срок носки истёк&#xa;Запись остаётся в истории&#xa;Показать путь к новой заявке" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="540" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b-repeat" value="Новая заявка&#xa;Право проверяется заново&#xa;Наличие подтверждается складом" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1050" y="710" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b-audit" value="Аудит и корректировки&#xa;Кто • когда • что изменил • основание&#xa;Исправления не стирают историю выдачи&#xa;Администратор не меняет срок задним числом без журнала" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="550" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b-proto-note" value="В текущем MVP вместо сервера — Redux Toolkit + localStorage и mock-данные. Демо-срок 3 года используется только как временная заглушка для позиций без настроенного норматива; в рабочем приложении такие позиции должны быть помечены как требующие проверки, а не выдавать ложный норматив." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;size=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="710" width="440" height="120" as="geometry" />
        </mxCell>
